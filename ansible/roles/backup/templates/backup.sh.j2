#!/bin/bash
set -euo pipefail

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="/opt/backups/prism_${TIMESTAMP}.sql.gz"
RETENTION_DAYS={{ backup_retention_days }}
S3_BUCKET="{{ s3_bucket_name }}"
AWS_REGION="{{ aws_region }}"

pg_dump -h {{ db_private_ip }} -U {{ db_user }} {{ db_name }} | gzip > "${BACKUP_FILE}"

aws s3 cp "${BACKUP_FILE}" "s3://${S3_BUCKET}/db/${BACKUP_FILE##*/}" --region "${AWS_REGION}"

find /opt/backups -name "*.sql.gz" -mtime +${RETENTION_DAYS} -delete

echo "[$(date)] Backup ${BACKUP_FILE} uploaded to S3 successfully"
