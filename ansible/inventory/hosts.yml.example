# Exemple d'inventaire
all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ~/.ssh/id_rsa
    ansible_ssh_common_args: "-o StrictHostKeyChecking=no"
    s3_bucket_name: "prism-backups-xxxx"
    aws_region: "eu-west-3"
    db_private_ip: "10.0.2.xxx"

loadbalancer:
  hosts:
    lb:
      ansible_host: X.X.X.X

app:
  hosts:
    app-1:
      ansible_host: X.X.X.X
      private_ip: 10.0.1.xxx
    app-2:
      ansible_host: X.X.X.X
      private_ip: 10.0.1.xxx

database:
  hosts:
    db:
      ansible_host: 10.0.2.xxx
      # Accès via ProxyJump : la DB n'est pas joignable directement depuis Internet
      ansible_ssh_common_args: "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand='ssh -W %h:%p -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i ~/.ssh/id_rsa ubuntu@<APP_IP_1>'"

citools:
  hosts:
    citools:
      ansible_host: X.X.X.X
